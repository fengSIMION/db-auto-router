# MCP Router 配置库连接信息

# ============ v4.1 配置存储模式（二选一） ============
# mysql  : 数据源配置存下方 MCP_CONFIG_* 指向的 MySQL 配置库（原有方式）
# sqlite : 数据源配置存 data/datasources.db 文件（随目录分发，用 DB Browser (SQLite) 维护，
#          首次运行自动建库建表；dir_path='*' 或空串 = 任意目录兜底数据源）
MCP_CONFIG_MODE=sqlite
# sqlite 模式的配置库文件路径（相对路径按本目录解析；可写绝对路径）
MCP_CONFIG_SQLITE_PATH=data/datasources.db
# ===================================================

# 仅 mysql 模式使用：配置库连接信息
MCP_CONFIG_HOST=127.0.0.1
MCP_CONFIG_PORT=3306
MCP_CONFIG_USER=root
MCP_CONFIG_PASSWORD=xxxx
MCP_CONFIG_DATABASE=mcp

# mysql 模式：版本探测结果的缓存秒数。每次工具调用都要探一次配置库版本号以感知
# 外部改动，不缓存就等于每次调用都新开一条到配置库的连接（配置库在远端时开销明显）。
# 只影响「多久之内不重复探测」——配置改完后最迟这么久被感知，仍属秒级。
# refresh_datasources 工具永远强制全量重读，不受此限。设 0 关闭缓存。
MCP_CONFIG_PROBE_TTL=2.0

# 数据库连接超时配置（秒）
MCP_CONNECT_TIMEOUT=10
MCP_READ_TIMEOUT=30

# 查询保护配置
MCP_MAX_RESULT_ROWS=1000        # 最大返回行数（无 LIMIT 时截断）

# 重试机制配置
MCP_MAX_RETRY_COUNT=3           # 最大重试次数
MCP_RETRY_DELAY=1.0             # 重试延迟（秒）

# 连接池配置
MCP_MAX_POOL_SIZE=10            # 连接池最大连接数
MCP_POOL_IDLE_TIME=300          # 连接最大空闲时间（秒），定期清理

# 结果摘要配置
MCP_SUMMARY_THRESHOLD=50        # 超过此行数自动摘要
MCP_SUMMARY_DISPLAY_ROWS=10     # 摘要时显示的行数

# 审计日志目录（每条 SQL 落一行 JSON；设为 off 关闭）
MCP_AUDIT_LOG_DIR=logs
# query_audit_log 默认扫描最近多少天的日志文件（按文件名里的日期判定，不看 mtime）。
# 原实现硬编码只取最近 3 个文件，第 4 天以前的记录就查不到了。传 0 = 不限天数扫全部。
MCP_AUDIT_LOG_SCAN_DAYS=30
# 审计日志保留天数：>0 时 MCP 启动会删除更早的 audit-*.jsonl；0 = 永久保留（默认）。
MCP_AUDIT_LOG_RETAIN_DAYS=0

# ============ v4.0 重武器：事务 / 批量 / 导入导出 ============
MCP_TXN_IDLE_TIMEOUT=600          # 事务空闲超时（秒），超时自动回滚释放锁
# v4.5：单条事务可在 begin_transaction(idle_timeout=) 里覆盖上面的全局默认，
# 长流程（等用户确认、跨轮次操作）按需放宽，不必把全局默认一起调大——
# 全局默认调大的代价是"忘记提交的事务"更久才放锁。
# 本项是那个覆盖值的天花板：传超过它的值会被直接拒绝。
# 防止误传巨大值让事务连同行锁表锁永不释放，这种事故在交互式会话里极难发现。
MCP_TXN_MAX_IDLE=86400            # 单事务空闲超时上限（秒），默认 24 小时
MCP_EXPORT_BATCH=2000             # export_csv 每批从游标读取的行数
MCP_IMPORT_BATCH=500              # import_csv 每批 executemany 提交的行数
MCP_EXPORT_MAX_ROWS=5000000       # 导出/导入行数硬上限（防爆盘）

# ============ 写操作确认 ============
# on = 弹确认（原生中文弹窗优先，客户端不支持时降级终端 elicitation）
# off = 跳过确认（保持 v2.x 行为，仅在确认完全可控的环境下使用）
MCP_WRITE_CONFIRM=on
# v4.6：上面的总开关之外，还有数据源级的 write_confirm 列（mcp_datasource_config，
# 默认 1=需审核）。某个数据源填 0（GUI 里取消打勾「写操作需人工审核」）=
# 该数据源的 execute/import_csv/dump_database 免确认，供开发库随便造数据。
# 两者是"与"的关系：总开关 off 全量跳过；数据源列只能把单个源放宽，不能反向收紧。
# 确认通道：auto = 弹窗优先(默认) / native = 仅原生弹窗 / elicit = 仅终端
MCP_WRITE_CONFIRM_UI=auto
# 确认弹窗中 SQL 最多展示的行数，超出折叠（完整语句始终写入服务端 stderr 日志）
MCP_WRITE_CONFIRM_PREVIEW_LINES=8
# dump_database 的 skip_confirm 参数仅在下面为 on 时才生效（脚本/CI 场景显式放开），
# 防止模型自行传 skip_confirm=True 绕过确认。默认注释掉 = 必须人工确认。
# MCP_DUMP_SKIP_CONFIRM=on

# 达梦(dm) 连接字符编码，默认 UTF-8；中文乱码时可试 GB18030
# MCP_DM_ENCODING=GB18030